# Copy to backend/.env (scripts/devdb.sh init does this and fills in the database URLs).
DATABASE_URL=postgresql+asyncpg://salesie:CHANGE_ME@127.0.0.1:5433/salesie
TEST_DATABASE_URL=postgresql+asyncpg://salesie:CHANGE_ME@127.0.0.1:5433/salesie_test

# Meta app settings (developers.facebook.com > your app > Settings > Basic / Webhooks)
META_APP_SECRET=CHANGE_ME
META_VERIFY_TOKEN=CHANGE_ME

# Owner dashboard login (HTTP Basic auth on /api). Password: at least 16 characters.
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME

# Lets the dashboard inject fake Meta events through the real webhook pipeline
SIMULATOR_ENABLED=true

# Serve /docs and /openapi.json (keep false on public deployments)
API_DOCS_ENABLED=false

# Sales agent. LLM_PROVIDER=mock uses a deterministic stand-in (no API credits needed).
# LLM_PROVIDER=muse calls Muse Spark on Meta Model API (or any OpenAI-compatible endpoint serving a Meta model,
# e.g. Muse Spark Open on Baseten: LLM_BASE_URL=https://inference.baseten.co/v1 LLM_MODEL=meta-models/muse-spark-open)
AGENT_ENABLED=true
LLM_PROVIDER=mock
MODEL_API_KEY=
LLM_BASE_URL=https://api.meta.ai/v1
LLM_MODEL=muse-spark-1.3

# Instagram Send API token. Leave empty to keep replies inside Salesie (nothing is sent to Meta).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v23.0

# Public URL of this server, used in payment links sent to shoppers (must be https with live Instagram)
PUBLIC_BASE_URL=http://localhost:8000
# The built-in checkout takes no money. Live Instagram + test checkout must be switched on deliberately.
ALLOW_TEST_CHECKOUT_WITH_LIVE_INSTAGRAM=false

# Agent load limits
AGENT_MAX_CONCURRENT_TURNS=4
AGENT_TURNS_PER_CONTACT_PER_DAY=40
